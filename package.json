{
  "name": "vastu-architect-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "db:up": "docker compose up -d --wait db",
    "build": "tsc -b && tsc -p server && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:server": "node --env-file-if-exists=.env --import tsx --test tests/server.test.ts",
    "test:live": "node --import tsx tests/request_live.mts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
