# Documentation only. JobPilot intentionally does not auto-load .env files.
# Export these in the terminal before starting the app.
JOBPILOT_IMAP_HOST=imap.gmail.com
JOBPILOT_IMAP_USER=your-email@example.com
JOBPILOT_IMAP_PASSWORD=
JOBPILOT_IMAP_LOOKBACK_DAYS=14
# Set OLLAMA_NO_CLOUD=1 in the Ollama service environment itself, then restart Ollama.
OLLAMA_NO_CLOUD=1
