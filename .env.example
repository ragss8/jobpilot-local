# Copy to .env and fill in. .env is git-ignored.

# Postgres started by `npm run db:up` (compose.yml)
DATABASE_URL=postgres://aangan:aangan-local@127.0.0.1:5433/aangan

# Signs login sessions. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Web application OAuth client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to sign in. Leave empty to allow any verified Google account.
ALLOWED_EMAILS=

API_PORT=8787
